# Azure TTS Configuration
SPEECH_KEY=your_azure_speech_key_here
SPEECH_REGION=northeurope

# OpenAI Configuration (for translation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_PATH=./data
OUTPUT_PATH=./output

# Assets Configuration
OVERLAY_PATH=./assets/overlay.png
LOOP_AUDIO_PATH=./assets/loop.wav

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
USE_GPU_ENCODING=true  # Enable NVENC/VideoToolbox GPU acceleration

# Performance Optimization (Optional)
# TEMP_PATH=R:/podcast_temp  # Use RAM Disk for temp files (20% faster I/O)
#                            # Requires: 16GB+ free RAM, ImDisk Toolkit or similar
#                            # Leave commented to use default (SSD)

# TTS Configuration
TTS_VOICE=en-GB-Ollie:DragonHDLatestNeural
TTS_RATE=-8%
TTS_PITCH=0%

# Application Configuration
MAX_VIDEO_DURATION_HOURS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Phonetics Configuration
PRONUNCIATIONS_CSV=./pronunciations.csv
