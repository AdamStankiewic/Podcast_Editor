# Azure TTS Configuration
SPEECH_KEY=your_azure_speech_key_here
SPEECH_REGION=northeurope

# OpenAI Configuration (for translation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_PATH=./data
OUTPUT_PATH=./output

# Assets Configuration
# Default overlay (fallback if language-specific not found)
OVERLAY_PATH=./assets/overlay.png

# Language-specific overlays (optional)
OVERLAY_PATH_PL=./assets/overlay_pl.png
OVERLAY_PATH_FR=./assets/overlay_fr.png
OVERLAY_PATH_EN=./assets/overlay_en.png

# Background music (shared across all languages)
LOOP_AUDIO_PATH=./assets/loop.wav

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
USE_GPU_ENCODING=true  # Enable NVENC/VideoToolbox GPU acceleration

# Performance Optimization (Optional)
# TEMP_PATH=R:/podcast_temp  # Use RAM Disk for temp files (20% faster I/O)
#                            # Requires: 16GB+ free RAM, ImDisk Toolkit or similar
#                            # Leave commented to use default (SSD)

# ===========================================
# TTS Provider Configuration
# ===========================================
# Choose TTS provider: "chatterbox" (default) or "azure"
TTS_PROVIDER=chatterbox

# --- Chatterbox Configuration (Primary) ---
# Model variant: "multilingual" (default), "turbo", or "standard"
CHATTERBOX_MODEL=multilingual
# Reference audio for voice cloning (optional, WAV or MP4)
CHATTERBOX_REFERENCE_AUDIO=./assets/voice_reference.wav
# Speech rate: 0.9 = 10% slower (storytelling style), 1.0 = normal
CHATTERBOX_RATE=0.9
# Emotion exaggeration: 0.0 (monotone) to 1.0 (dramatic), 0.5 for storytelling
CHATTERBOX_EXAGGERATION=0.5
# CFG weight: controls adherence to reference (0.3-0.5 recommended)
CHATTERBOX_CFG_WEIGHT=0.5

# --- Azure TTS Configuration (Fallback) ---
TTS_VOICE=en-GB-Ollie:DragonHDLatestNeural
TTS_RATE=-10%
TTS_PITCH=0%

# Application Configuration
MAX_VIDEO_DURATION_HOURS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Phonetics Configuration
PRONUNCIATIONS_CSV=./pronunciations.csv
